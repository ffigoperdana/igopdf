# IGO Backend Environment Variables
# Copy this file to .env and configure as needed.

# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=igopdf
DB_USER=igopdf
DB_PASSWORD=igopdf_password

# Session
SESSION_SECRET=change-me-in-production
SESSION_TIMEOUT_HOURS=3

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CAPTCHA
CAPTCHA_EXPIRY_MINUTES=5

# Auth
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Logging
LOG_LEVEL=info

# Server-side compression for PDFs above 100 MB. Keep disabled until the
# pdf-worker service and its storage volume are configured.
SERVER_COMPRESSION_ENABLED=false
COMPRESSION_JOBS_DIR=/var/lib/igo-jobs
CLIENT_COMPRESSION_MAX_BYTES=104857600
SERVER_BALANCED_MAX_BYTES=524288000
SERVER_COMPRESSION_MAX_BYTES=1073741824
COMPRESSION_UPLOAD_CHUNK_BYTES=26214400
COMPRESSION_UPLOAD_IDLE_TIMEOUT_MS=1800000
COMPRESSION_UPLOAD_MAX_AGE_MS=10800000
COMPRESSION_DISK_HEADROOM_MULTIPLIER=3
COMPRESSION_DISK_MINIMUM_FREE_BYTES=1073741824
COMPRESSION_JOB_TIMEOUT_MS=2700000
COMPRESSION_RETENTION_MS=900000
COMPRESSION_WORKER_POLL_MS=2000

# Guide and Aduan assets. Mount this directory as a private persistent volume;
# it is never served as a public static directory.
SUPPORT_STORAGE_DIR=/var/lib/igo-support
SUPPORT_UPLOAD_CHUNK_BYTES=26214400
SUPPORT_UPLOAD_IDLE_TIMEOUT_MS=3600000
SUPPORT_UPLOAD_MAX_AGE_MS=86400000
COMPLAINT_ATTACHMENT_RETENTION_MS=172800000
GUIDE_PDF_MAX_BYTES=104857600
GUIDE_VIDEO_MAX_BYTES=104857600
SUPPORT_DISK_MINIMUM_FREE_BYTES=536870912

# Optional ClamAV malware scanning for Guide and Aduan uploads. Set
# MALWARE_SCAN_ENABLED=true only after the private clamd service is running.
# When enabled, failures are rejected by default rather than stored unscanned.
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=900000
MALWARE_SCAN_MAX_BYTES=1073741824

# Complaint email notifications through the internal Postfix relay. The relay
# authorizes the IGO host by IP and the sender address; do not add SMTP
# username/password here unless the mail team explicitly changes the policy.
EMAIL_ENABLED=false
SMTP_HOST=10.10.10.25
SMTP_PORT=25
SMTP_SECURE=false
# Set true only if the relay requires STARTTLS on port 25.
SMTP_REQUIRE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_FROM=authorized-sender@bpdp.or.id
SMTP_REPLY_TO=
EMAIL_DOMAIN=bpdp.or.id
APP_PUBLIC_URL=https://igo.bpdp.or.id
